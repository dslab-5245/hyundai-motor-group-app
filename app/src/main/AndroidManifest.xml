<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android Automotive OS only (Pleos Connect). -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Foreground media playback service (API 34 requires the typed permission). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Pleos Vehicle SDK read permissions (protectionLevel normal; names from the official sample manifest).
         Only the signals the music engine actually uses are requested. -->
    <uses-permission android:name="pleos.car.permission.READ_CAR_STEERING" />   <!-- steering angle -->
    <uses-permission android:name="pleos.car.permission.CAR_POWERTRAIN" />      <!-- gear, brake pedal, drive mode -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />           <!-- driving mode / cruise -->
    <uses-permission android:name="pleos.car.permission.READ_ADAS_STATES" />    <!-- cruise control state -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />          <!-- turn signal -->
    <uses-permission android:name="pleos.car.permission.READ_WINDSHIELD_WIPERS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />           <!-- seat occupancy -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />          <!-- seat belt, telltales -->
    <uses-permission android:name="pleos.car.permission.CAR_MILEAGE" />         <!-- trip time / distance -->
    <uses-permission android:name="pleos.car.permission.CAR_SPEED" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />

    <!-- Pleos NaviHelper SDK (speed limit, TBT, caution points, position). -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.NAVI_CUSTOM_ETC" />

    <application
        android:name=".DriveSymphonyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DriveSymphony"
        tools:targetApi="34">

        <!-- Pleos App Market category hint: Music / Audio (driving-allowed category). -->
        <meta-data android:name="pleos.app.category" android:value="MUSIC_AUDIO" />
        <meta-data android:name="com.android.automotive" android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.DriveSymphony">
            <!-- The activity is distraction-optimized: while driving it shows only the glance (Flow) screen. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gleo App Schema action filters (see assets/schema.json). -->
            <intent-filter>
                <action android:name="io.drivesymphony.action.START_SYMPHONY" />
                <action android:name="io.drivesymphony.action.SET_GENRE" />
                <action android:name="io.drivesymphony.action.HOW_IS_MY_DRIVING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".audio.SymphonyService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Media button events (steering wheel play/pause) -->
        <receiver android:name="androidx.media.session.MediaButtonReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
