<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android Automotive OS only (Pleos Connect). -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Foreground media playback service (API 34 requires the typed permission). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />

    <!-- Pleos Vehicle SDK permissions (protectionLevel normal). Names are the @RequiresPermission strings found in
         Vehicle-2.3.2 (ai.pleos.playground.vehicle.constant.PleosPermission) for exactly the nine registrations this app makes.
         Pleos App Market requires Vehicle SDK permissions to be pre-negotiated at submission; declare only what is used. -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />    <!-- steering angle, brake pedal, gear, drive mode, cruise -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />   <!-- turn signal -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />  <!-- wiper state (WindowArea FRONT_WINDSHIELD) -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />    <!-- seat occupancy, seat belt -->

    <!-- Pleos NaviHelper SDK (speed limit, TBT, caution points, position). -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <application
        android:name=".DriveSymphonyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:appCategory="audio"
        android:theme="@style/Theme.DriveSymphony"
        tools:targetApi="34">

        <!-- Pleos App Market category hint: Music / Audio (driving-allowed category). -->
        <meta-data android:name="pleos.app.category" android:value="MUSIC_AUDIO" />
        <!-- Pleos launcher exposure (Music/Audio app guide). -->
        <meta-data android:name="androidx.car.app.launchable" android:value="true" />
        <meta-data android:name="com.android.automotive" android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.DriveSymphony">
            <!-- The activity is distraction-optimized: while driving it shows only the glance (Flow) screen. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gleo App Schema: intent action == function name, JSON args in extra "ACTION_PARAM" (see assets/schema.json). -->
            <intent-filter>
                <action android:name="startSymphony" />
                <action android:name="setGenre" />
                <action android:name="howIsMyDriving" />
                <action android:name="pauseSymphony" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".audio.SymphonyService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
            <!-- Gleo function calls delivered directly to the service (schema component = "service"). -->
            <intent-filter>
                <action android:name="startSymphony" />
                <action android:name="setGenre" />
                <action android:name="howIsMyDriving" />
                <action android:name="pauseSymphony" />
            </intent-filter>
        </service>

        <!-- Media button events (steering wheel play/pause) -->
        <receiver android:name="androidx.media.session.MediaButtonReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
        <!-- Share "여정의 곡" cards as images (cache/share/*.png). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
